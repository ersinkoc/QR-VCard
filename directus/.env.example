# Directus container config (docker compose env_file). Copy to directus/.env and edit.
HOST=0.0.0.0
PORT=8055
PUBLIC_URL=http://localhost:8055

DB_CLIENT=sqlite3
DB_FILENAME=/directus/database/data.db

# CHANGE THESE in any shared/production setup
KEY=replace-with-openssl-rand-hex-32
SECRET=replace-with-openssl-rand-hex-32

# CORS: the app's browser code calls this Directus directly, so Directus must allow the
# origin the app is served from. `true` allows ANY origin — fine locally, too wide for a
# public deployment (any site could read your Directus from a visitor's browser). For
# production, set CORS_ORIGIN to the app's domain(s) instead.
CORS_ENABLED=true
CORS_ORIGIN=true

# Created on first container start (directus bootstrap)
ADMIN_EMAIL=admin@local.dev
ADMIN_PASSWORD=vcard-admin

# Panel accounts created by directus/bootstrap.mjs
EDITOR_EMAIL=editor@local.dev
EDITOR_PASSWORD=vcard-editor
USER_EMAIL=ada@local.dev
USER_PASSWORD=vcard-user
