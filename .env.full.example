# QR-VCard complete stack (docker-compose.full.yml): PostgreSQL + Directus + app.
# Copy to .env and replace every value. Generate secrets with: openssl rand -hex 32
# Full guide: docs/deploy.md

# ---- Directus ---------------------------------------------------------------------
# Database password (internal to the stack).
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-32
# Directus signing secret.
DIRECTUS_SECRET=replace-with-openssl-rand-hex-32
# The first admin account — also your sign-in for the QR-VCard panel.
DIRECTUS_ADMIN_EMAIL=admin@example.com
DIRECTUS_ADMIN_PASSWORD=replace-with-a-strong-password
# Static token given to that admin on the FIRST start; the app uses it too.
# Changing it later does not change Directus — keep it as it was first deployed.
DIRECTUS_TOKEN=replace-with-openssl-rand-hex-32
# Public address of Directus Studio (only used for links inside Directus).
DIRECTUS_PUBLIC_URL=http://localhost:8055

# ---- App ------------------------------------------------------------------------
SESSION_SECRET=replace-with-openssl-rand-hex-32
# Public address of the app, e.g. https://kart.example.com (QR codes point here).
PUBLIC_URL=
# 1 behind a reverse proxy (Coolify/Traefik, nginx, Cloudflare); 0 when exposed directly.
TRUST_PROXY=1
# Optional artistic QR provider key (standard QR codes work without it).
QR_API_KEY=

# ---- Host ports --------------------------------------------------------------------
# APP_PORT=8080
# DIRECTUS_PORT=8055
