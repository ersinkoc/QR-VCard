# QR-VCard server configuration. Everything here is read at RUNTIME by the Node
# server (npm run start / npm run api) — nothing is baked into the browser bundle,
# and the browser never talks to Directus directly.

# --- Directus (required) ---------------------------------------------------------
# Base URL the SERVER uses to reach Directus, and the static token of the service
# account. `npm run directus:bootstrap` creates that account and writes both values
# here when they are missing.
DIRECTUS_URL=http://localhost:8055
DIRECTUS_TOKEN=

# Cookie signing key (>= 16 chars, e.g. `openssl rand -hex 32`). Optional: when
# empty it is derived from DIRECTUS_TOKEN, so rotating the token signs everyone out.
SESSION_SECRET=

# Cards a plain user may own (admins and editors are unlimited).
MAX_CARDS_PER_USER=20

# Behind a reverse proxy (Railway, Coolify, nginx, Traefik…) set to 1, so rate
# limits key on the real client (last X-Forwarded-For hop) instead of the proxy.
TRUST_PROXY=
# Force the Secure cookie flag. Automatic on https or X-Forwarded-Proto: https.
COOKIE_SECURE=

# Public address of the site, e.g. https://kart.example.com. QR codes encode
# PUBLIC_URL/c/<code>. Optional: when empty, the address each request arrived on
# is used (X-Forwarded-Host / -Proto aware). Set it in production.
PUBLIC_URL=

# --- QR provider -------------------------------------------------------------------
# Served by this same server at GET /api/qr/<code> — there is no separate proxy.
# The key goes in the `ApiKey` header as the bare value; it never reaches the browser.
QR_API_URL=https://artqrcode.oxog.net
QR_API_KEY=
# POST /api/qr rate limit per client, guarding the metered provider.
QR_RATE_LIMIT_MAX=30
QR_RATE_LIMIT_WINDOW_MS=60000

# --- server --------------------------------------------------------------------------
# Listen port. In development the Vite dev server (:5173) forwards /api to it.
PORT=8787

# --- remote Directus provisioning (ops scripts only) ---------------------------------
# Read by directus/bootstrap.mjs + directus/verify.mjs when provisioning an existing
# instance with an admin's static token:
#   DIRECTUS_ADMIN_TOKEN=
