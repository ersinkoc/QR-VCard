# Frontend -> Directus connection
VITE_DIRECTUS_URL=http://localhost:8055

# QR proxy endpoint (optional). The app POSTs here and the server-side proxy
# (server/qr-proxy.mjs) attaches the provider's ApiKey, so no key ever ships in
# the client bundle. Defaults to the same-origin path /api/qr, which Vite
# forwards to the local proxy in development; set this only when the proxy is
# served from a different origin.
VITE_QR_PROXY_URL=

# --- server-side only: read by `npm run qr:proxy`, never sent to the browser ---
# Provider base URL and key for `POST /QR/create`. The key goes in the `ApiKey`
# header as the bare value (the Swagger's "ApiKey <key>" form is rejected 401).
QR_API_URL=https://artqrcode.oxog.net
QR_API_KEY=
# Port the proxy listens on, and the browser origins it allows (comma list, or
# * for any). The Vite dev server is http://localhost:5173.
PORT=8787
QR_ALLOWED_ORIGINS=http://localhost:5173

# --- remote Directus provisioning (ops scripts only — never shipped to the browser) ---
# Read by directus/bootstrap.mjs + directus/verify.mjs; process env wins over
# directus/.env, so exporting these for one command always takes effect. The admin
# token must exist only here / in a deploy-platform secret — never as a VITE_* name.
#   DIRECTUS_URL=https://directus.example.com
#   DIRECTUS_ADMIN_TOKEN=
