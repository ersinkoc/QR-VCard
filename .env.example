# QR-VCard — runtime configuration (Docker, Nixpacks/Coolify, Railway or `npm start`).
# Copy to .env, or enter the same keys in your platform's environment variables.
# Nothing is needed at build time. Check a filled-in file with: npm run doctor
# Full guide: docs/deploy.md

# ---- Required ---------------------------------------------------------------
# Directus base URL as the APP SERVER reaches it (browsers never call Directus).
# Inside Docker, "localhost" is the container itself — use the Directus domain
# or the Docker service name (http://directus:8055).
DIRECTUS_URL=https://directus.example.com
# Static token of a Directus user with the Administrator role
# (Directus Studio → User Directory → the user → Token → generate → Save).
# Administrator access lets the app create/repair its collections on start.
DIRECTUS_TOKEN=replace-with-directus-administrator-static-token

# ---- Strongly recommended ------------------------------------------------------
# Cookie signing key, at least 16 characters: openssl rand -hex 32
SESSION_SECRET=replace-with-openssl-rand-hex-32
# Public address of this app (no trailing path). QR codes encode PUBLIC_URL/c/<code>.
PUBLIC_URL=https://kart.example.com
# 1 when a reverse proxy (Coolify/Traefik, Railway, nginx, Cloudflare) sits in front:
# rate limits then key on the real visitor address. 0 only when exposed directly.
TRUST_PROXY=1

# ---- Optional ---------------------------------------------------------------------
# Artistic QR provider. Without a key, clean standard QR codes are generated locally.
QR_API_URL=https://artqrcode.oxog.net
QR_API_KEY=
# Cards a plain user may own (default 20).
# MAX_CARDS_PER_USER=20
# Provision/repair the Directus schema on every start (default 1). 0 = managed separately.
# DIRECTUS_BOOTSTRAP=1
# Seconds to wait for Directus to answer on start (default 120).
# DIRECTUS_WAIT_SECONDS=120
# 1 creates demo accounts and cards (never in production).
# BOOTSTRAP_SEED_DEMO=0
# Time zone for the panel's daily view statistics (default UTC), e.g. Europe/Istanbul.
# QRV_TZ=UTC
# Logs: json (default) or text.
# LOG_FORMAT=json
# Listen port. Platforms usually inject it; the Docker image defaults to 8080.
# PORT=8080
