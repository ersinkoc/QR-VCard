# Frontend -> Directus connection
VITE_DIRECTUS_URL=http://localhost:8055

# QR generation API (required). The app POSTs to {VITE_QR_API_URL}/QR/create
# with the link in a JSON InputParameters body and authenticates with an
# `ApiKey` header (Swagger: https://artqrcode.oxog.net/swagger/index.html).
# Left empty on purpose: the app then fails with an explicit configuration
# error instead of quietly rendering nothing.
VITE_QR_API_URL=

# Key for `POST /QR/create`, sent as the `ApiKey` header (the bare key — the
# Swagger's "ApiKey <key>" form is rejected with 401).
# WARNING: Vite inlines VITE_* values into the client bundle, so this key is
# readable by anyone who loads the app. Fine for local development; use a
# server-side proxy before shipping anything public.
# The `npm run qr:verify` diagnostic also reads this, and prefers the non-VITE
# name QR_API_KEY for exactly that reason.
VITE_QR_API_KEY=
