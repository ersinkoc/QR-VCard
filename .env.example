[TEMPLATE]
# ==============================================================================
# QR-VCard Environment Configuration (.env.example)
# ==============================================================================
# All values here are read at RUNTIME by the Node server (npm run start / npm run api).
# Nothing is baked into the frontend bundle at build time, and the browser never
# talks directly to Directus or the QR provider.
#
# Copy this file to `.env`:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION SERVER & NETWORK
# ------------------------------------------------------------------------------
# Listen port for the application server.
# In development, `npm run dev:all` runs Vite on :5173 and the API on :8787.
# In production, `npm run start` defaults to 8080 (or respects PORT).
PORT=8787

# The public canonical URL of the site, e.g. https://kart.example.com
# QR codes encode `${PUBLIC_URL}/c/<code>`.
# If empty, the server infers the origin from incoming request headers (Host/X-Forwarded-*).
# Highly recommended to set this in production!
PUBLIC_URL=

# Set to 1 when running behind a reverse proxy / load balancer (Nginx, Caddy, Traefik,
# Cloudflare, Coolify, Railway, Docker, etc.).
# This ensures rate limiting and security guards key on the real client IP (last X-Forwarded-For hop).
TRUST_PROXY=0

# Set to 1 to force the `Secure` flag on the session cookie.
# (Automatic when request is HTTPS or carries `X-Forwarded-Proto: https`).
COOKIE_SECURE=0

# Directory of built static assets served by server/serve.mjs (default: ./dist)
DIST_DIR=./dist

# ------------------------------------------------------------------------------
# 2. SESSION & ACCOUNT SECURITY
# ------------------------------------------------------------------------------
# Secret key used to HMAC-sign session cookies (must be >= 16 characters).
# Generate one with: openssl rand -hex 32
# If left empty, it is automatically derived from DIRECTUS_TOKEN.
SESSION_SECRET=

# Maximum number of business cards a standard user (vcard-user) can create.
# Administrators and Editors have unlimited card creation rights.
MAX_CARDS_PER_USER=20

# ------------------------------------------------------------------------------
# 3. DIRECTUS BACKEND (REQUIRED)
# ------------------------------------------------------------------------------
# Base URL used server-to-server to communicate with Directus.
# The browser never sees or calls this address.
DIRECTUS_URL=http://localhost:18055

# Static authentication token for the QR-VCard service account.
# Automatically generated and written here when running `npm run directus:bootstrap`.
DIRECTUS_TOKEN=

# ------------------------------------------------------------------------------
# 4. QR CODE GENERATION (STANDARD & ARTISTIC)
# ------------------------------------------------------------------------------
# Enable automatic fallback to local Standard QR code generation when no remote API key is set.
# 1 = enabled (default): zero external API keys needed; clean, high-contrast QR codes work out-of-the-box.
# 0 = disabled: requires QR_API_KEY for QR generation.
QR_FALLBACK_STANDARD=1

# (Optional) API key for the remote Art QR provider (https://artqrcode.oxog.net).
# When provided, users can toggle between clean Standard QR and stylized Artistic QR.
# The key stays securely on the server and is never exposed to the client.
QR_API_KEY=

# Base URL for the remote Art QR API provider.
QR_API_URL=https://artqrcode.oxog.net

# Rate limit for metered remote QR generation per client.
QR_RATE_LIMIT_MAX=30
QR_RATE_LIMIT_WINDOW_MS=60000

# ------------------------------------------------------------------------------
# 5. DIRECTUS BOOTSTRAP & SEED ACCOUNTS (OPS & SCRIPTS)
# ------------------------------------------------------------------------------
# Used by `npm run directus:bootstrap` to provision roles, permissions, seed users,
# and demo business cards.
#
# If provisioning a remote or existing Directus instance that already has an admin token:
DIRECTUS_ADMIN_TOKEN=

# Default Administrator account (manages users and all cards):
ADMIN_EMAIL=admin@local.dev
ADMIN_PASSWORD=vcard-admin
ADMIN_SEED_CODE=demo-admin

# Default Editor account (manages all cards; cannot manage users):
EDITOR_EMAIL=editor@local.dev
EDITOR_PASSWORD=vcard-editor

# Default User account (manages only own cards and profile):
USER_EMAIL=ada@local.dev
USER_PASSWORD=vcard-user
SEED_CODE=demo-01

# System service account identity created in Directus:
SERVICE_EMAIL=qr-vcard-service@example.com

# ------------------------------------------------------------------------------
# 6. SMOKE TESTS & HEALTH CHECKS (OPTIONAL)
# ------------------------------------------------------------------------------
# Used by `npm run smoke` to verify an active deployment end-to-end:
#   SMOKE_BASE_URL=https://kart.example.com
#   PANEL_EMAIL=admin@local.dev
#   PANEL_PASSWORD=vcard-admin

# ------------------------------------------------------------------------------
# 6b. LOGGING (OPTIONAL)
# ------------------------------------------------------------------------------
# Log line format: json (default, one JSON object per line — request id,
# method, path, status, duration) or text (compact human-readable).
LOG_FORMAT=json

# Requests slower than this many milliseconds are flagged "slow": true and
# logged at warn level (default 1000).
LOG_SLOW_MS=1000

# 1 = also log successful /healthz and /api/health calls (skipped by default;
# the container healthcheck would otherwise flood the log). Failing health
# checks are always logged.
LOG_HEALTH=0
