# Frontend -> Directus connection
VITE_DIRECTUS_URL=http://localhost:8055

# QR generation API (required). The app calls it with GET, passing the short
# link as a query parameter, and expects image bytes back (Content-Type
# image/png or image/svg+xml); the browser loads that URL as the <img> src.
# Use a literal {data} placeholder, or the link is appended as ?data=<encoded>:
#   https://qr.example.com/make?text={data}
#   https://qr.example.com/gen
# Left empty on purpose: the app then fails with an explicit configuration
# error instead of quietly rendering nothing. The endpoint must also allow
# cross-origin fetches (Access-Control-Allow-Origin) for the panel's
# "Download" button, which fetches the image to save it.
VITE_QR_API_URL=
