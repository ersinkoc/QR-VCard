# Frontend -> Directus connection
VITE_DIRECTUS_URL=http://localhost:8055

# Optional: your QR generation API. The literal `{data}` is replaced with the
# URL-encoded target link, e.g. https://qr.example.com/api?text={data}
# If unset (or when running in the browser without this var), QR codes are
# generated locally with the qrcode package.
VITE_QR_API_URL=
