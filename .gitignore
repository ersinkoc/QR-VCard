backups/

# Playwright artifacts (test-results, reports) and the throwaway credentials
test-results/
playwright-report/
.playwright/

# Directus (Docker volumes live in named volumes; local-only artifacts below)
directus/.env
directus/data.db
directus/data.db*
directus/.bootstrap-state.json

